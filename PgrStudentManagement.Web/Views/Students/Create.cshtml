@model PgrStudentManagement.Web.Models.Student

@{
    ViewData["Title"] = "Create Student";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-action="Index">Students</a></li>
            <li class="breadcrumb-item active" aria-current="page">Create Student</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h1 class="h4 mb-0"><i class="bi bi-person-plus"></i> Create New PGR Student</h1>
                    <small class="text-white-50">W3-UC01: Register a new postgraduate research student</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <h5 class="text-primary border-bottom pb-2 mb-3">1. Personal & Identification</h5>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="StudentNumber" class="form-label fw-bold">Student Number <span class="text-danger">*</span></label>
                                <input asp-for="StudentNumber" class="form-control" placeholder="e.g. S100003" required />
                                <span asp-validation-for="StudentNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FirstName" class="form-label fw-bold">First Name <span class="text-danger">*</span></label>
                                <input asp-for="FirstName" class="form-control" placeholder="e.g. Alice" required />
                                <span asp-validation-for="FirstName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="LastName" class="form-label fw-bold">Last Name <span class="text-danger">*</span></label>
                                <input asp-for="LastName" class="form-control" placeholder="e.g. Walker" required />
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">2. Programme & Enrolment Details</h5>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="Course" class="form-label">Research Programme / Course</label>
                                <input asp-for="Course" class="form-control" placeholder="e.g. PhD Computing" />
                                <span asp-validation-for="Course" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ModeOfStudy" class="form-label">Mode of Study</label>
                                <select asp-for="ModeOfStudy" class="form-select">
                                    <option value="Full-time">Full-time</option>
                                    <option value="Part-time">Part-time</option>
                                </select>
                                <span asp-validation-for="ModeOfStudy" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="StartDate" class="form-label">Enrolment Start Date</label>
                                <input asp-for="StartDate" type="date" class="form-control" />
                                <span asp-validation-for="StartDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Status" class="form-label fw-bold">Academic Status <span class="text-danger">*</span></label>
                                <select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<PgrStudentManagement.Web.Models.Status>()">
                                </select>
                                <span asp-validation-for="Status" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="text-primary border-bottom pb-2 mb-3 mt-4">3. Thesis Information (Optional)</h5>
                        <div class="mb-3">
                            <label asp-for="ThesisTitle" class="form-label">Working Thesis Title</label>
                            <input asp-for="ThesisTitle" class="form-control" placeholder="e.g. Deep Learning Architectures for Signal Processing" />
                            <span asp-validation-for="ThesisTitle" class="text-danger small"></span>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="ExpectedSubmissionDate" class="form-label">Expected Thesis Submission Date</label>
                                <input asp-for="ExpectedSubmissionDate" type="date" class="form-control" />
                                <span asp-validation-for="ExpectedSubmissionDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="ActualSubmissionDate" class="form-label">Actual Thesis Submission Date</label>
                                <input asp-for="ActualSubmissionDate" type="date" class="form-control" />
                                <span asp-validation-for="ActualSubmissionDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between pt-3 border-top">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                            <button type="submit" class="btn btn-primary px-4">Create Student</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
